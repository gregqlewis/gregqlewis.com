{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gregqlewis-com",
  "compatibility_date": "2026-11-07",
  // Serve only on gregqlewis.com and www (set in the dashboard). No second
  // public copy on workers.dev, and no public preview URLs for other branches.
  "workers_dev": false,
  "preview_urls": false,
  // Static site only: no Worker script. Everything in ./public is served as-is,
  // and ./public/_headers sets the security headers.
  "assets": {
    "directory": "./public"
  }
}
